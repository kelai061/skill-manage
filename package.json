{
  "name": "skill-atelier",
  "productName": "Skill Atelier",
  "version": "1.0.1",
  "description": "",
  "author": "kelai061",
  "license": "MIT",
  "main": "main/main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/launch.cjs",
    "dev": "node scripts/launch.cjs --dev",
    "test": "node scripts/run-tests.cjs",
    "pack": "node scripts/pack.cjs",
    "dist": "electron-builder --win nsis portable --x64",
    "dist:setup": "electron-builder --win nsis --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:dir": "electron-builder --win dir --x64",
    "test:ui": "node scripts/run-scenario.cjs scripts/scenarios/v13.cjs",
    "test:ui14": "node scripts/run-scenario.cjs scripts/scenarios/v14.cjs",
    "test:ui15": "node scripts/run-scenario.cjs scripts/scenarios/v15.cjs",
    "test:ui16": "node scripts/run-scenario.cjs scripts/scenarios/v16.cjs",
    "test:ui17": "node scripts/run-scenario.cjs scripts/scenarios/v17.cjs",
    "test:ui18": "node scripts/run-scenario.cjs scripts/scenarios/v18.cjs"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.skillatelier.app",
    "productName": "SkillAtelier",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "SkillAtelier-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "SkillAtelier",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "SkillAtelier-${version}.exe",
      "unpackDirName": "SkillAtelier"
    }
  }
}
